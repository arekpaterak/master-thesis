# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environment
.venv

# .env files
.env

# JetBrains IDE files
.idea/
.run/

# Project related
# Track the small, figure-facing eval files; keep raw per-instance data and plots local.
experiments/results/eval/**
!experiments/results/eval/**/
!experiments/results/eval/**/summary.csv
!experiments/results/eval/**/steps.csv
!experiments/results/eval/**/config.yml
!experiments/results/eval/**/cvrplib-*/instances.csv
# Training runs: track only curated 'featured' runs -- their config.yml and wandb_run_id.
# Checkpoints are hand-picked per run in that run's own .gitignore. Non-featured runs,
# plots, and tmp stay local.
experiments/runs/**
!experiments/runs/NOTES.md
!experiments/runs/**/
!experiments/runs/*/featured/*/config.yml
!experiments/runs/*/featured/*/wandb_run_id
!experiments/runs/*/featured/*/.gitignore
experiments/pretrained/*
!experiments/pretrained/nds/.gitkeep

# Marimo
__marimo__/
notebooks/checkpoints/

# W&B
wandb/

# AI agents
.claude

data/*/*
!data/synthetic/.gitkeep
!data/cvrplib/.gitkeep

notebooks/playground.ipynb

experiments/runs/**/tmp/
experiments/results/**/tmp/
